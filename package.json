{
  "name": "maclaya",
  "version": "0.1.0",
  "description": "Run Laya typed-decision models locally on Apple Silicon behind a Jev (TypeSafe System One) compatible API, with a dashboard and playground.",
  "license": "Apache-2.0",
  "keywords": [
    "laya",
    "jev",
    "typesafe",
    "system-one",
    "mlx",
    "apple-silicon",
    "local-ai"
  ],
  "bin": {
    "maclaya": "dist/cli.js"
  },
  "files": [
    "dist",
    "python",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsup",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "tsup --watch --onSuccess \"node dist/cli.js serve --no-open\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:e2e": "MACLAYA_E2E=1 jest tests/e2e",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.4",
    "commander": "^15.0.0",
    "fastify": "^5.12.5",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
